# Copy to .env.local for local development. Both values are safe to expose to the browser;
# Row Level Security in the database is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://ykdksrmxqjxeweeejwpj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_j6VRFWuJ0PNGNi1XvHvaPA_r4423UOh

# NEVER put the Supabase secret / service_role key in a NEXT_PUBLIC_ variable.

# Google Drive (server only, never NEXT_PUBLIC). Paste the whole service account JSON on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_FOLDER_ID=

# Ideas page (server only, never NEXT_PUBLIC).
# Web search: https://app.tavily.com  (free plan: 1,000 searches a month, no card)
TAVILY_API_KEY=
# AI summary: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which Gemini model to use (default gemini-3.5-flash-lite)
GEMINI_MODEL=
